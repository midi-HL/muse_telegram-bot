# Copy to ".env", fill in the real token, keep the file chmod 600.
# .env is gitignored — never commit it.

# Required: token from @BotFather (/newbot). Format: <bot-id>:<secret>
BOT_TOKEN=PASTE_BOT_TOKEN_HERE

# Optional: Bot API base URL. Default: https://api.telegram.org
# Point this at a self-hosted Bot API server to lift the 20 MB
# file-download limit of the public Bot API.
# TELEGRAM_API_BASE=https://api.telegram.org
